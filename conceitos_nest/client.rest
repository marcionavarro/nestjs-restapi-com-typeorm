@baseUrl = http://127.0.0.1:3000

# Recados
### Lista todos os recados
GET {{baseUrl}}/recados/
?limit=10
&offset=0

### Lista apenas um recado
GET {{baseUrl}}/recados/12/

### Cria um recado
POST {{baseUrl}}/recados
Content-Type: application/json

{
    "text": "De Carlos para Joana",
    "deId": 10,
    "paraId": 11
}

### Atualiza um recado
PATCH  {{baseUrl}}/recados/13/
Content-Type: application/json

{
    "text": "De Carlos para Joana - atualizado",
    "lido": true
}

### Remove  um recado
DELETE {{baseUrl}}/recados/4/

################################################################

# Pessoa
### Lista todos as pessoas
GET {{baseUrl}}/pessoas/
?limit=10
&offset=0

### Lista apenas uma pessoa
GET {{baseUrl}}/pessoas/10/

### Cria uma pessoa
POST {{baseUrl}}/pessoas
Content-Type: application/json

{
    "nome": "Ana",
    "email": "ana@example.com",
    "password": "123456"
}

### Atualiza uma pessoa
PATCH  {{baseUrl}}/pessoas/10/
Content-Type: application/json

{
    "password": "654321",
    "nome": "João"
}

### Remove uma pessoa
DELETE {{baseUrl}}/pessoas/12/